# Copy to .env.local (git-ignored) and fill in.
# Values are the form IDs from your Formspree dashboard — the part after
# https://formspree.io/f/. They are public by design (they ship in the bundle).

# "Let's talk teaming" contact form
VITE_FORMSPREE_CONTACT_FORM_ID=

# "Get teaming updates" newsletter signup in the footer
VITE_FORMSPREE_NEWSLETTER_FORM_ID=
