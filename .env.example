# Copy to .env.local (git-ignored) and fill in.
# Values are Web3Forms access keys (dashboard → form → Access Key). They are
# public by design: Web3Forms expects them in client-side HTML.

# "Let's talk teaming" contact form ("TrueConvos Federal — Contact")
VITE_WEB3FORMS_CONTACT_ACCESS_KEY=

# "Get teaming updates" signup in the footer ("TrueConvos Federal — Mailing list")
VITE_WEB3FORMS_NEWSLETTER_ACCESS_KEY=
